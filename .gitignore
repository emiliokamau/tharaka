# Add these to .gitignore to keep sensitive data and cache out of version control
.env
*.pyc
__pycache__/
.vscode/
.idea/
scraped_data/
*.json
!.env.example
!vercel.json
venv/
.venv/
.dist/
*.log

# Extras and documentation (not needed for project to work)
extras/
docs/
*.md

# Data files (PDFs)
*.pdf

# Model reports
model_reports/

# Binary files - models and databases
*.pkl
*.db
instance/
backend/instance/
backend/models/
models/
