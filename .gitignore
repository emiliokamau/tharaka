*.pyc
__pycache__/
.vscode/
.idea/
scraped_data/
*.json
!.env.example
!vercel.json
venv/
.venv/
.dist/
*.log

# Extras and documentation (not needed for project to work)
extras/
docs/

# Data files (PDFs)
*.pdf

# Model reports
model_reports/
